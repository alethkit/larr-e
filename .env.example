# Copy to .env (gitignored) and fill in. LARR-E loads it at startup; variables already set in the
# environment win. Point LARRE_ENV_FILE elsewhere to use a different file.

# --- secrets ---------------------------------------------------------------
# A dedicated key for LARR-E (Claude Console), ideally in a workspace with a spend limit.
ANTHROPIC_API_KEY=
# Slack app (see README section 4)
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
# Pioreactor broker login: `grep -A6 '^\[mqtt\]' ~/.pioreactor/config.ini` on the Pi
LARRE_MQTT_USERNAME=
LARRE_MQTT_PASSWORD=
# Shared secret for `larr-e api` (3DS / dashboard); generated per run if empty
LARRE_API_TOKEN=

# --- this setup: laptop on the hotspot, real Pi + optional twin --------------
LARRE_MQTT_HOST=pioreactor.local
LARRE_LEADER_URL=http://pioreactor.local
LARRE_PUMP_TRANSPORT=rest
LARRE_RECORD_DB=1
LARRE_DB_PATH=./runtime/cluster.sqlite
# LARRE_LEADERS=twin1=http://127.0.0.1:8790,twin2=http://127.0.0.1:8790
# LARRE_SLACK_ALERT_CHANNEL=C0123456789
# LARRE_DRY_RUN=1
