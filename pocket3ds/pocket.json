{
  "$schema": "https://pocketjs.dev/schema/pocket-2.json",
  "pocket": 2,
  "id": "dev.larr-e.3ds",
  "name": "larr-e-3ds",
  "title": "LARR-E",
  "version": "0.1.0",
  "engine": {
    "capabilities": {
      "requires": [
        "io.offload",
        "text.glyphs.baked",
        "input.buttons",
        "display.auxiliary",
        "input.touch.auxiliary"
      ]
    }
  },
  "app": {
    "entry": "app/main.tsx",
    "output": "larr-e-main",
    "framework": "solid",
    "viewport": {
      "fixed": { "logical": [400, 240], "presentation": "native" }
    },
    "surfaces": {
      "auxiliary": {
        "fixed": { "logical": [320, 240], "presentation": "native" }
      }
    }
  }
}
