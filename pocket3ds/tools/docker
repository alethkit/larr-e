#!/usr/bin/env bash
# Docker CLI shim over Podman, so PocketJS's 3DS build (written for Docker Desktop on macOS)
# runs on Linux:  PATH="$PWD/tools:$PATH" bun run 3ds
# - `docker info` only needs to succeed; Podman's template fields differ.
# - SELinux (Fedora) blocks containers from reading bind-mounted home folders: disable labels.
# - Podman refuses short image names non-interactively: qualify the devkitARM image.
args=()
for a in "$@"; do args+=("${a/#devkitpro\/devkitarm@/docker.io/devkitpro/devkitarm@}"); done
case "${args[0]}" in
  info) podman version --format '{{.Client.Version}}' ;;
  run) exec podman run --security-opt label=disable "${args[@]:1}" ;;
  *) exec podman "${args[@]}" ;;
esac
